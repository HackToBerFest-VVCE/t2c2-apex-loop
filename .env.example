# Copy this file to .env. GEMINI_API_KEY is server-only (never sent to the browser): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google OAuth Client ID (Web application) — lets "Send with Gmail" send directly with the photo attached.
VITE_GOOGLE_CLIENT_ID=

# Optional backup AI provider (free key: https://console.groq.com/keys). Used when Google is overloaded.
GROQ_API_KEY=
# Optional second Groq key, tried if the first one fails
GROQ_API_KEY_2=

# Encrypts the sign-in cookie (server-only). Any random string of 32+ characters.
SESSION_SECRET=

# Google OAuth client secret (server-only): Google Cloud > Credentials > your OAuth client
GOOGLE_CLIENT_SECRET=

# Google accounts that can open the admin "All reports" page (comma-separated)
ADMIN_EMAILS=

# Postgres connection string (added automatically when you connect Neon in Vercel)
DATABASE_URL=
